% Задача 4. Счастливый билет.
% Билет счастливый, если сумма первых трёх цифр равна сумме последних трёх.

% Переменные решения: шесть цифр билета, каждая из диапазона 0..9.
array[1..6] of var 0..9: d;

% Ограничение: суммы половин равны.
constraint d[1] + d[2] + d[3] = d[4] + d[5] + d[6];

% Ищем любое решение, удовлетворяющее ограничениям.
solve satisfy;

output [
  "Билет: ",
  show(d[1]), show(d[2]), show(d[3]),
  show(d[4]), show(d[5]), show(d[6]), "\n",
  "Сумма каждой половины: ", show(d[1] + d[2] + d[3]), "\n"
];
