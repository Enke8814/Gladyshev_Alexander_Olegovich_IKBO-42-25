% Задача 5. Разрешение зависимостей пакетов по схеме из задания.
% Классический пример конфликта версий (pubgrub).
%
% Исходные данные:
%   root                зависит от menu ^1.0.0 и icons ^1.0.0
%   menu 1.1.0..1.5.0   зависят от dropdown ^2.0.0
%   menu 1.0.0          зависит от dropdown ^1.8.0
%   dropdown 2.0.0..2.3.0 зависят от icons ^2.0.0
%   dropdown 1.8.0      зависит от icons ^1.0.0
%
% Версии кодируются порядковыми номерами по возрастанию,
% поэтому сравнение версий превращается в сравнение чисел.

% menu:     1 = 1.0.0, 2 = 1.1.0, 3 = 1.2.0, 4 = 1.3.0, 5 = 1.4.0, 6 = 1.5.0
% dropdown: 1 = 1.8.0, 2 = 2.0.0, 3 = 2.1.0, 4 = 2.2.0, 5 = 2.3.0
% icons:    1 = 1.0.0, 2 = 2.0.0

array[1..6] of string: menu_ver     = ["1.0.0","1.1.0","1.2.0","1.3.0","1.4.0","1.5.0"];
array[1..5] of string: dropdown_ver = ["1.8.0","2.0.0","2.1.0","2.2.0","2.3.0"];
array[1..2] of string: icons_ver    = ["1.0.0","2.0.0"];

% Переменные решения: какую версию каждого пакета выбрать.
var 1..6: menu;
var 1..5: dropdown;
var 1..2: icons;

% root зависит от icons ^1.0.0 — подходит только 1.0.0,
% версия 2.0.0 меняет старший разряд и под ограничение не попадает.
constraint icons = 1;

% menu версий 1.1.0..1.5.0 требуют dropdown ^2.0.0 (номера 2..5).
constraint menu >= 2 -> dropdown >= 2;

% menu 1.0.0 требует dropdown ^1.8.0 (номер 1).
constraint menu = 1 -> dropdown = 1;

% dropdown версий 2.0.0..2.3.0 требуют icons ^2.0.0 (номер 2).
constraint dropdown >= 2 -> icons = 2;

% dropdown 1.8.0 требует icons ^1.0.0 (номер 1).
constraint dropdown = 1 -> icons = 1;

% Менеджер пакетов предпочитает более свежие версии,
% поэтому ищем не любое решение, а максимальное по версиям.
solve maximize menu * 100 + dropdown * 10 + icons;

output [
  "menu     = ", menu_ver[fix(menu)], "\n",
  "dropdown = ", dropdown_ver[fix(dropdown)], "\n",
  "icons    = ", icons_ver[fix(icons)], "\n"
];
