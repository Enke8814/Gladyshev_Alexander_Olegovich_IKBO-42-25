% Задача 4. Счастливый билет с дополнительными условиями:
% все цифры различны, сумма трёх цифр минимальна.

% Библиотека глобальных ограничений, оттуда берётся all_different.
include "globals.mzn";

array[1..6] of var 0..9: d;

% Отдельная переменная под сумму половины — её и будем минимизировать.
var 0..27: s;

% Все шесть цифр попарно различны.
constraint all_different(d);

% Суммы половин равны, s хранит это общее значение.
constraint s = d[1] + d[2] + d[3];
constraint d[1] + d[2] + d[3] = d[4] + d[5] + d[6];

% Не просто найти решение, а найти решение с наименьшим s.
solve minimize s;

output [
  "Билет: ",
  show(d[1]), show(d[2]), show(d[3]),
  show(d[4]), show(d[5]), show(d[6]), "\n",
  "Сумма каждой половины: ", show(s), "\n"
];
